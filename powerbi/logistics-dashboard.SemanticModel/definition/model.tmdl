model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["gold dim_customers","gold dim_date","gold dim_drivers","gold dim_routes","gold dim_vehicles","gold dim_warehouses","gold fact_delivery_events","gold fact_shipments"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'gold dim_customers'
ref table 'gold dim_date'
ref table 'gold dim_drivers'
ref table 'gold dim_routes'
ref table 'gold dim_vehicles'
ref table 'gold dim_warehouses'
ref table 'gold fact_delivery_events'
ref table 'gold fact_shipments'

ref cultureInfo en-US

